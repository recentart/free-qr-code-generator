# Cloudflare Pages response headers.
# connect-src 'none' means the page cannot send data anywhere, even by mistake.
# If you add ads or analytics later, you will need to loosen this policy.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
