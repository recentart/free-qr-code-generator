# Cloudflare response headers.
# The generator page can't connect anywhere (connect-src 'none'), even by mistake.
# Ads run only inside sandboxed frames under /ad/, which get their own policy below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; frame-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The ad frame needs Adsterra's scripts, so it gets its own policy. It is always
# sandboxed (opaque origin), so nothing in it can reach the generator page above.
/ad/*
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; frame-ancestors 'self'
  ! X-Frame-Options
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
